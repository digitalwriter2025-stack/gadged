<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent directory browsing
    Options -Indexes

    # Block access to hidden files and dotfiles (except .well-known for SSL certificates)
    RewriteRule ^\.(?!well-known).* - [F,L]

    # Block access to sensitive configuration, build, and dependency files
    RewriteRule ^(\.env.*|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan|boost\.json|\.git.*)$ - [F,L,NC]

    # Route public media/storage requests to public/storage
    RewriteRule ^storage/app/public/(.*)$ public/storage/$1 [L]
    RewriteRule ^storage/(.*)$ public/storage/$1 [L]

    # Block direct HTTP access to internal Laravel application directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor)(/.*)?$ - [F,L,NC]

    # Block access to private storage directories (logs, framework, private files)
    RewriteRule ^storage/(framework|logs|app/(?!public)) - [F,L,NC]

    # Pass Authorization header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Pass X-XSRF-Token header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Rewrite all other traffic into the public/ directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
